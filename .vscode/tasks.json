{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install packages",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": []
    },
    {
      "label": "Start Dastan AR",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "dependsOn": ["Install packages"],
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
